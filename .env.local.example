# Salin file ini jadi .env.local lalu isi nilainya.
# Lokal: Supabase Dashboard > Project Settings > API
# Vercel: Project > Settings > Environment Variables

# ---- Supabase (wajib) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya untuk kode server (app/api). Jangan pernah dipakai di halaman browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Penjadwal (wajib agar cron harian & notifikasi jalan) ----
# Teks acak minimal 16 karakter. Vercel mengirimnya sebagai Bearer token.
CRON_SECRET=

# ---- Pembayaran (opsional; isi hanya penyedia yang dipakai) ----
# xendit | midtrans | tripay
PAYMENT_PROVIDER=

# Xendit (disarankan: xenPlatform + split payment, platform tidak menampung dana)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_MASTER_ACCOUNT_ID=

# Midtrans (QRIS Core API)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# TriPay (QRIS)
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_IS_PRODUCTION=false
TRIPAY_QRIS_METHOD=QRIS
TRIPAY_FALLBACK_EMAIL=pelanggan@example.com

# ---- Notifikasi WhatsApp (opsional) ----
# Gateway generik yang menerima POST JSON {to, message}
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
